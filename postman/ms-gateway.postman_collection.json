{
  "info": {
    "_postman_id": "d346b58f-543e-5ccf-9b84-94ef6bcb8a26",
    "name": "BodegaNube - ms-gateway",
    "description": "Entrada unica al backend. Requiere todo el sistema corriendo (docker compose up en bodeganube-infra) o el cluster Swarm (cambiar baseUrl a http://<IP-manager>:8080). Muestra el login con JWT, el control de acceso por rol, el aislamiento por comercio, el webhook M2M con API key y la salud de cada microservicio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login operario (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"operario\",\n  \"password\": \"{{operarioPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },

          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"pm.response.json().mensaje.includes(\\\"Falta el token\\\")\", () => pm.expect(pm.response.json().mensaje.includes(\"Falta el token\")).to.be.true);"
            ]

    {
      "name": "Webhook con API key: crea la orden y reserva stock (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"externalOrderId\", \"shopify-gw-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"ordenId\", pm.response.json().id);",
              "pm.test(\"pm.response.json().estado === \\\"LISTA_PARA_PICKING\\\"\", () => pm.expect(pm.response.json().estado === \"LISTA_PARA_PICKING\").to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Api-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/webhooks/ordenes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalOrderId\": \"{{externalOrderId}}\",\n  \"comercioId\": \"comercio-123\",\n  \"items\": [\n    {\n      \"productoId\": \"{{sku}}\",\n      \"cantidad\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
